---
// Layout base del portafolio. Reutiliza toda la lógica genérica ya
// aprobada (URL canónica, favicons, ClientRouter) e integra el Layout
// Global (Header + Footer) construido en la Etapa 3.
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { withBase } from '@/lib/assetPath';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portafolio profesional.' } = Astro.props;

// Reutilizado del Layout.astro original: normaliza la URL canónica y fuerza
// https:// para evitar mixed content si SITE_URL llega mal configurada.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
if (canonicalURL.protocol === 'http:') canonicalURL.protocol = 'https:';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon: se conservan los archivos existentes como placeholder
         hasta que se genere el set definitivo con la identidad del portafolio. -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/images/favicons/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('/images/favicons/apple-icon-180x180.png')} />
    <link rel="manifest" href={withBase('/manifest.json')} />

    <title>{title}</title>

    <ClientRouter />

    <!-- Anti-FOUC: aplica el estado guardado del Header contraído antes del
         primer paint. Bloqueante e intencionalmente mínimo (una lectura de
         sessionStorage); ver Header.astro para el resto de la lógica. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('portfolio:header-collapsed') === 'true') {
          document.documentElement.dataset.headerCollapsed = 'true';
        }
      } catch {
        /* sessionStorage no disponible — el header simplemente arranca expandido */
      }
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
