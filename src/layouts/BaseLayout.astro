---
// Layout base del portafolio. Reutiliza toda la lógica genérica ya
// aprobada (URL canónica, favicons, ClientRouter) e integra el Layout
// Global (Header + Footer) construido en la Etapa 3.
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { withBase } from '@/lib/assetPath';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import I18nController from '@/components/i18n/I18nController.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portafolio profesional.' } = Astro.props;

// URL pública normalizada para canonical, Open Graph y datos estructurados.
const siteOrigin = Astro.site ?? new URL('https://salijz.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
if (canonicalURL.protocol === 'http:') canonicalURL.protocol = 'https:';

const socialImageURL = new URL(withBase('/social-preview.png'), siteOrigin);
const profileImageURL = new URL(withBase('/images/profile/joaquin-salinas.webp'), siteOrigin);
const homeURL = new URL(withBase('/'), siteOrigin);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joaquin Augusto Salinas Tuesta',
  alternateName: 'Joaquin Salinas',
  url: homeURL.href,
  image: profileImageURL.href,
  jobTitle: 'Technical Game Designer | Technical QA | Gameplay Programmer',
  sameAs: [
    'https://github.com/SaliJz',
    'https://linkedin.com/in/joaquinsalinast',
  ],
  knowsAbout: [
    'Unity',
    'C#',
    'Gameplay Systems',
    'Technical Game Design',
    'Technical QA',
    'Game Development',
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Joaquin Salinas" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph: preview al compartir el enlace en LinkedIn, WhatsApp, Discord, Facebook, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joaquin Salinas | Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:secure_url" content={socialImageURL.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Joaquin Salinas — Technical Game Designer, Technical QA y Gameplay Programmer" />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter/X Card usa la misma imagen social. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <meta name="twitter:image:alt" content="Joaquin Salinas — Technical Game Designer, Technical QA y Gameplay Programmer" />

    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48x48.png')} />
    <link rel="shortcut icon" href={withBase('/favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.json')} />
    <meta name="theme-color" content="#0a1628" />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <ClientRouter />

    <!-- Anti-FOUC: aplica el estado guardado del Header contraído antes del
         primer paint. Bloqueante e intencionalmente mínimo (una lectura de
         sessionStorage); ver Header.astro para el resto de la lógica. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('portfolio:header-collapsed') === 'true') {
          document.documentElement.dataset.headerCollapsed = 'true';
        }
      } catch {
        /* sessionStorage no disponible — el header simplemente arranca expandido */
      }

      try {
        const lang = localStorage.getItem('portfolio:lang');
        const htmlLang = { es: 'es', en: 'en', fr: 'fr', pt: 'pt', zh: 'zh-Hans' }[lang ?? ''];
        if (htmlLang) document.documentElement.lang = htmlLang;
      } catch {
        /* localStorage no disponible — español permanece como idioma inicial */
      }
    </script>
  </head>
  <body>
    <I18nController />
    <Header />
    <slot />
    <Footer />
  </body>
</html>
