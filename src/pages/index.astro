---
/**
 * index.astro — Home principal del portafolio.
 *
 * Las secciones del portafolio están montadas en orden de lectura y usan
 * contenido profesional real conectado al sistema de internacionalización.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import About from '@/components/about/About.astro';
import Projects from '@/components/projects/Projects.astro';
import Skills from '@/components/skills/Skills.astro';
import Certificates from '@/components/certificates/Certificates.astro';
import Contact from '@/components/contact/Contact.astro';
import es from '@/i18n/es';
---

<BaseLayout title={es.meta.title} description={es.meta.description}>
  <a href="#main" class="skip-link">Saltar al contenido</a>

  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Projects />
    <Skills />
    <Certificates />
    <Contact />
  </main>
</BaseLayout>
