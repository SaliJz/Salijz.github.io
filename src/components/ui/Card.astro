---
/**
 * Card.astro
 * Superficie base compartida por toda tarjeta del portafolio (proyectos,
 * timeline de "Sobre mí", habilidades, certificados, contacto...).
 * Centraliza bordes, sombra, padding y radio para que "todas las tarjetas
 * compartan bordes, sombras, padding, radios y hover" (dirección artística).
 *
 * No contiene contenido: recibe todo vía slots. `interactive` habilita el
 * hover de elevación para tarjetas que son o contienen un enlace/acción.
 */
interface Props {
  interactive?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
  as?: 'div' | 'article' | 'li';
  [key: `data-${string}`]: string | undefined;
}

const { interactive = false, padding = 'md', class: className, as: Tag = 'div', ...rest } = Astro.props;
---

<Tag class:list={['card', `card--padding-${padding}`, { 'card--interactive': interactive }, className]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    background-color: var(--color-bg-surface);
    border: var(--border-width-thin) solid var(--color-border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    /* Necesario para que un contenido "a sangre" (p. ej. la imagen de
       portada de ProjectCard, Etapa 6) respete las esquinas redondeadas
       en vez de sobresalir de ellas. No afecta a los usos existentes de
       Card (Timeline, Style Guide), que no dependen de overflow visible. */
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .card--padding-none {
    padding: 0;
  }

  .card--padding-sm {
    padding: var(--space-4);
  }

  .card--padding-md {
    padding: var(--space-6);
  }

  .card--padding-lg {
    padding: var(--space-8);
  }

  .card--interactive {
    cursor: pointer;
  }

  .card--interactive:hover,
  .card--interactive:focus-within {
    transform: translateY(-4px);
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-lg);
  }
</style>
