---
/**
 * BrandIcon.astro
 *
 * EXCEPCIÓN DOCUMENTADA al uso exclusivo de Lucide para iconografía.
 * Lucide (Etapa 2) es deliberadamente un set de iconos de INTERFAZ
 * genéricos y no incluye logos de marca (GitHub, YouTube, Steam, itch.io,
 * etc.). Para los botones de acción de Proyectos que enlazan a esas
 * plataformas, se necesita el logo real y reconocible de cada una — un
 * icono genérico de Lucide (p. ej. "Play" para YouTube) sería ambiguo.
 *
 * En vez de instalar una segunda librería de iconos general (lo que sí
 * violaría "no mezclar sistemas de iconos"), este componente centraliza
 * SOLO 4 logos de marca como SVG estáticos, en un único archivo, para que
 * el resto de la interfaz (navegación, botones, badges...) siga usando
 * Lucide exclusivamente y esta sea la única puerta de entrada a un logo
 * de marca en todo el proyecto.
 *
 * Procedencia y licencias de cada trazo (verificadas, no dibujadas a mano):
 *  - github, youtube, steam, linkedin → Bootstrap Icons (MIT License).
 *    https://icons.getbootstrap.com — sin requisito de atribución visible.
 *  - itchio → Font Awesome Free 6.1.1 (Icons: CC BY 4.0).
 *    https://fontawesome.com/icons/itch-io — la licencia CC BY exige
 *    atribución "razonablemente accesible"; se satisface con este mismo
 *    comentario (práctica habitual para un uso de icono puntual). Si en el
 *    futuro se prefiere evitar la obligación de atribución de itch.io,
 *    puede sustituirse por un mark propio o por texto "itch.io" sin logo.
 *
 * Todos los trazos usan `currentColor`, igual que los iconos de Lucide,
 * así que heredan el color de texto del Button/Badge que los contiene.
 */

type BrandName = 'github' | 'youtube' | 'steam' | 'itchio' | 'linkedin';

interface Props {
  name: BrandName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

