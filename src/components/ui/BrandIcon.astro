---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={brand.viewBox}
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {brand.paths.map((d) => <path d={d} />)}
</svg>
