---
/**
 * Badge.astro
 * Indicador de ESTADO puntual (p. ej. "In Development", "Completed",
 * "SYSTEM STATUS · ONLINE"). Lleva un punto de color + texto para que el
 * estado sea reconocible incluso sin leer la etiqueta.
 *
 * Distinto de Tag.astro: Badge comunica un estado (semántico, con color),
 * Tag clasifica/etiqueta contenido (neutro, informativo). No mezclar los
 * dos usos para no diluir el significado del color dorado/estados.
 */
interface Props {
  variant?: 'accent' | 'success' | 'info' | 'danger' | 'neutral';
  class?: string;
}

const { variant = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, className]}>
  <span class="badge__dot" aria-hidden="true"></span>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: var(--border-width-thin) solid var(--color-border-default);
    background-color: var(--color-bg-surface-alt);
    font-family: var(--font-tech);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: currentColor;
    flex-shrink: 0;
  }

  .badge--accent {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .badge--success {
    color: var(--raw-success);
    border-color: color-mix(in srgb, var(--raw-success) 40%, transparent);
  }

  .badge--info {
    color: var(--color-secondary-cyan);
    border-color: color-mix(in srgb, var(--color-secondary-cyan) 40%, transparent);
  }

  .badge--danger {
    color: var(--color-text-danger);
    border-color: color-mix(in srgb, var(--raw-red-500) 40%, transparent);
  }

  .badge--neutral {
    color: var(--color-text-secondary);
  }
</style>
